<Window x:Class="Projet.views.Window1"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projet.views"
        mc:Ignorable="d"
        Title="Window1" Height="450" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="380"/>
            
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#1F4E79">
            <StackPanel 
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Margin="40,0"
                >
                <TextBlock Text="Gesticoop" 
                          FontSize="35"
                          Foreground="White"
                          FontWeight="Bold"
                          />
                <TextBlock Text="Gerez vos stages cooperatifs"
                           FontSize="15"
                           Foreground="FloralWhite"
                           Margin="0,25,0,0"
                           />
                
                <!--Zone des statique -->
                <StackPanel Orientation="Horizontal" 
                            Margin="0,50,0,0"
                            HorizontalAlignment="Center">
                    <!--nombre D'etudient-->
                    <StackPanel  HorizontalAlignment="Center" Margin="0,0,25,0">
                        <TextBlock Text="248" 
                                   FontSize="25" 
                                   Foreground="White"
                                   FontWeight="Bold"/>

                        <TextBlock Text="etudiant.e.s"
                                   Foreground="White"
                                   />



                    </StackPanel>

                    <!--nombre D'offres-->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,25,0">
                        <TextBlock Text="87" 
                        FontSize="25" 
                        Foreground="White"
                        FontWeight="Bold"/>
                        <TextBlock Text="offres de stage"
                        Foreground="White"
                        />


                    </StackPanel>

                    <!--nombre entreprise-->
                    <StackPanel HorizontalAlignment="Center" Margin="0,0,25,0">
                        <TextBlock Text="348" 
                         FontSize="25" 
                         Foreground="White"
                         FontWeight="Bold"/>

                        <TextBlock Text="entreprises"
                         Foreground="White"
                        />

                    </StackPanel>



                </StackPanel>

            </StackPanel>
            
        </Border>

        <Border Grid.Column="1"
                Padding="40.0"
                Background="FloralWhite">

            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                
                <TextBlock Text="Connexion" FontSize="25"
                      FontWeight="Bold"
                      HorizontalAlignment="Center"
                      Margin="0,0,0,10"
                      Foreground="#191970"
                                            />


                <StackPanel Orientation="Horizontal">

                    <RadioButton Content="Etudiant" Margin="0,0,10,0"/>
                    <RadioButton Content="Entreprise" Margin="0,0,10,0"/>
                    <RadioButton Content="Coordonatuer" Margin="0,0,10,0"/>
                       
                </StackPanel>
                <TextBlock Text="Matricule"/>
                <TextBox Margin="0,0,0,10"/>
                <TextBlock Text="Mot de passe"/>
                <PasswordBox Margin="0,0,0,10"/>

                <Button Content="Se connecter" Margin="0,0,0,10"/>
                <Button Content="Connexion sso La cite"/>
                







            </StackPanel>

            


        </Border>

                
           


       
        
    </Grid>
</Window>
