<Window x:Class="Projet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projet"
        mc:Ignorable="d"
        Title="GestiCoop"
        Height="750"
        Width="1000"
        WindowStartupLocation="CenterScreen">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="#1F4E79">

            <StackPanel>

                <TextBlock Text="GestiCoop"
                           Foreground="White"
                           FontSize="20"
                           FontWeight="Bold"
                           HorizontalAlignment="Center"
                           Margin="0,20,0,20"/>

                <TextBlock Text="Stages coopératifs"
                           Foreground="White"
                           Margin="10,-10,0,40"/>

                <TextBlock Text="PRINCIPAL"
                           Foreground="White"
                           Margin="20,0,0,30"/>

                <TextBlock Text="Offres de stage"
                           Foreground="White"
                           Margin="20,0,0,30"/>

                <TextBlock Text="Étudiants"
                           Foreground="White"
                           Margin="20,0,0,30"/>

                <TextBlock Text="Candidatures"
                           Foreground="White"
                           Margin="20,0,0,30"/>

                <TextBlock Text="Entreprises"
                           Foreground="White"
                           Margin="20,0,0,30"/>

            </StackPanel>

        </Border>

        <Grid Grid.Column="1">

            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Background="#1F4E79">

                <TextBlock Text="GestiCoop - Gestion des stages coopératifs"
                           Foreground="White"
                           FontSize="15"
                           VerticalAlignment="Center"
                           Margin="20,0,0,0"/>

            </Border>

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Background="White">

                <StackPanel Margin="15,20,15,20">

                    <TextBlock Text="Offres de stage"
                               Foreground="Black"
                               FontSize="22"
                               FontWeight="Bold"
                               Margin="0,0,0,10"/>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,30">

                        <TextBlock Text="Publier une nouvelle offre"
                                   Foreground="Black"
                                   FontSize="14"
                                   Margin="0,0,25,0"/>

                        <TextBlock Text="Consulter la liste des offres existantes"
                                   Foreground="Black"
                                   FontSize="14"/>

                    </StackPanel>

                    <Border Background="White"
                            BorderBrush="#D3D3D3"
                            BorderThickness="1"
                            CornerRadius="5"
                            MinHeight="250"
                            Margin="0,0,0,20"
                            Padding="15">

                        <StackPanel>

                            <TextBlock Text="Nouvelle offre de stage"
                                       Foreground="Black"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0,0,0,20"/>

                            <Grid Margin="0,0,0,15">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">

                                    <TextBlock Text="Entreprise"
                                               Foreground="Black"
                                               FontSize="15"
                                               Margin="0,0,0,8"/>

                                    <ComboBox Height="30"
                                              Width="200"
                                              HorizontalAlignment="Left"
                                              FontSize="14"
                                              Background="White"
                                              Foreground="Black"
                                              BorderBrush="#D3D3D3"
                                              BorderThickness="1"
                                              SelectedIndex="0">

                                        <ComboBoxItem Content="Sélectionner une entreprise"
                                                      IsEnabled="False"/>

                                        <ComboBoxItem Content="Entreprise A"/>
                                        <ComboBoxItem Content="Entreprise B"/>
                                        <ComboBoxItem Content="Entreprise C"/>

                                    </ComboBox>

                                </StackPanel>

                                <StackPanel Grid.Column="1">

                                    <TextBlock Text="Titre du poste"
                                               Foreground="Black"
                                               FontSize="15"
                                               Margin="0,0,0,8"/>

                                    <TextBox Height="30"
                                             Width="300"
                                             HorizontalAlignment="Left"
                                             FontSize="14"
                                             Background="White"
                                             Foreground="Black"
                                             BorderBrush="#D3D3D3"
                                             BorderThickness="1"
                                             Padding="5"/>

                                </StackPanel>

                            </Grid>

                            <TextBlock Text="Description"
                                       Foreground="Black"
                                       FontSize="15"
                                       Margin="0,0,0,8"/>

                            <TextBox Height="100"
                                     Width="400"
                                     HorizontalAlignment="Left"
                                     FontSize="14"
                                     Background="White"
                                     Foreground="Black"
                                     BorderBrush="#D3D3D3"
                                     BorderThickness="1"
                                     Padding="5"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"/>

                            <TextBlock Text="Programme"
                                       Foreground="Black"
                                       FontSize="15"
                                       Margin="0,15,0,8"/>

                            <ComboBox Width="400"
                                      Height="35"
                                      HorizontalAlignment="Left"
                                      Background="White"
                                      BorderBrush="#D3D3D3"
                                      BorderThickness="1"
                                      SelectedIndex="0">

                                <ComboBoxItem Content="Sélectionner un ou plusieurs programmes"
                                              IsEnabled="False"/>

                                <ComboBoxItem>
                                    <CheckBox Content="Programmation informatique"/>
                                </ComboBoxItem>

                                <ComboBoxItem>
                                    <CheckBox Content="Réseaux informatiques"/>
                                </ComboBoxItem>

                                <ComboBoxItem>
                                    <CheckBox Content="Cybersécurité"/>
                                </ComboBoxItem>

                                <ComboBoxItem>
                                    <CheckBox Content="Administration des affaires"/>
                                </ComboBoxItem>

                            </ComboBox>

                            <TextBlock Text="Lieu de travail"
                                       Foreground="Black"
                                       FontSize="15"
                                       Margin="0,15,0,8"/>

                            <TextBox Height="30"
                                     Width="400"
                                     HorizontalAlignment="Left"
                                     FontSize="14"
                                     Background="White"
                                     Foreground="Black"
                                     BorderBrush="#D3D3D3"
                                     BorderThickness="1"
                                     Padding="5"/>

                        </StackPanel>

                    </Border>

                    <Border Background="White"
                            BorderBrush="#D3D3D3"
                            BorderThickness="1"
                            CornerRadius="5"
                            Height="250"
                            Padding="15">

                        <StackPanel>

                            <TextBlock Text="Liste des offres de stage"
                                       Foreground="Black"
                                       FontSize="18"
                                       FontWeight="Bold"/>

                        </StackPanel>

                    </Border>

                </StackPanel>

            </ScrollViewer>

        </Grid>

    </Grid>

</Window>